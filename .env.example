# Environment examples; .env files are not loaded automatically.
OWNSEARCH_SOURCES_FILE=sources.txt
OWNSEARCH_SEARCH_TIMEOUT_MS=12000
OWNSEARCH_MAX_PAGES_PER_QUERY=20
OWNSEARCH_MAX_REQUESTS_PER_QUERY=32
OWNSEARCH_MAX_BYTES_PER_QUERY=8000000
OWNSEARCH_CRAWL_THREADS=4
OWNSEARCH_DEFAULT_DELAY=1
OWNSEARCH_CACHE_TTL=900
OWNSEARCH_CACHE_ENTRIES=128
OWNSEARCH_CACHE_MAX_BYTES=16000000
OWNSEARCH_TIMEZONE=Asia/Kolkata
