# Examples only. OwnSearch reads environment variables, not .env files automatically.
# Choose a configured general provider. Leaving both empty means no general web discovery.
OWNSEARCH_SEARCH_MODE=live
OWNSEARCH_SEARXNG_URL=
# Set true only for your explicitly configured local/private SearXNG instance.
OWNSEARCH_SEARXNG_ALLOW_PRIVATE=false
# Optional paid/account-based alternative. Supply your own key outside source control.
OWNSEARCH_BRAVE_API_KEY=
OWNSEARCH_LIVE_LOCAL_ENABLED=false
OWNSEARCH_LIVE_FETCH_PAGES=3
OWNSEARCH_LIVE_FETCH_CONCURRENCY=3
OWNSEARCH_LIVE_FETCH_TIMEOUT=4
OWNSEARCH_LIVE_MAX_PAGE_BYTES=2000000
OWNSEARCH_LIVE_MAX_TOTAL_BYTES=6000000
OWNSEARCH_LIVE_MAX_REQUESTS=16
OWNSEARCH_DISCOVERY_TIMEOUT=8
OWNSEARCH_DISCOVERY_PROVIDER_TIMEOUT=3
OWNSEARCH_LIVE_CACHE_TTL=0
OWNSEARCH_LIVE_CACHE_ENTRIES=32
OWNSEARCH_PROVIDER_MIN_INTERVAL=1
OWNSEARCH_PROVIDER_COOLDOWN=30
OWNSEARCH_TIMEZONE=Asia/Kolkata

# Per-provider request budget and circuit threshold.
OWNSEARCH_PROVIDER_REQUEST_BUDGET=60
OWNSEARCH_PROVIDER_BUDGET_WINDOW=60
OWNSEARCH_PROVIDER_FAILURE_THRESHOLD=3

# Free official-API supplements; independently optional and subject to public limits.
# No key is required for these basic adapters. Keep arxiv off if the network is denied.
# Example candidate profile (evaluate before activation):
# OWNSEARCH_VERTICAL_PROVIDERS=github,pypi,npm,crates,openalex,stackexchange,wikipedia
OWNSEARCH_VERTICAL_PROVIDERS=
OWNSEARCH_VERTICAL_MAX_PROVIDERS=3
# Self-hosted general discovery stays available regardless of vertical intent routing.
