new file mode 100644
index 0000000..2ef48df
--- /dev/null
+++ b/tests/test_queryvariants.py
@@ -0,0 +1,81 @@
+"""Query constraints, bounded calls, and real-source-only RRF."""
+import threading
+import time
+import unittest
+from ownsearch.query import parse_query
+from ownsearch.queryvariants import compact_request,variants,rrf_rows
+from ownsearch.webmodels import WebRequest,WebCandidate
+from ownsearch.webproviders import SourceBatch,JsonProvider
+from ownsearch.coordinator import LiveSearch
+from scripts.benchmark_query_md import Recorder
+from tests.test_live_web import settings,Source,row
+
+
+class QueryVariantTests(unittest.TestCase):
+    def request(self,text):return WebRequest(text,parse_query(text),threading.Event())
+    def test_prefix_compaction_preserves_all_constraints(self):
+        text='Could you please help me find "orbital sensor" site:docs.example.org -advertising after:2020-01-01'
+        compact=compact_request(text)
+        self.assertEqual(compact,'"orbital sensor" site:docs.example.org -advertising after:2020-01-01')
+        for choice in variants(self.request(text)):
+            for value in ('"orbital sensor"','site:docs.example.org','-advertising','after:2020-01-01'):
+                self.assertIn(value,choice)
+        self.assertEqual(variants(self.request(text))[0],text)
+        self.assertEqual(compact_request('"Please find" is a quoted title'),'"Please find" is a quoted title')
+    def test_negation_keeps_complete_wording_and_no_synonyms_are_invented(self):
+        text='Please find orbital sensors without batteries'
+        self.assertEqual(variants(self.request(text)),[text,'orbital sensors without batteries'])
+        self.assertLessEqual(len(variants(self.request('Please find the orbital sensor guide'))),3)
+    def test_duplicate_url_can_vote_only_once_per_variant_and_query_order_is_preserved(self):
+        a={'url':'https://docs.example.org/sensor?z=1&a=2&a=1','title':'Sensor','source_query':'sensor'}
+        b={'url':'https://docs.example.org/other','title':'Other','source_query':'sensor guide'}
+        rows=rrf_rows([SourceBatch([a,a,b]),SourceBatch([b])])
+        self.assertEqual(rows[0]['url'],b['url'])
+        self.assertEqual(rows[1]['url'],a['url'])
+        self.assertEqual(len(rows[1]['source_query_ranks']),1)
+        item=WebCandidate.from_row(rows[0],'fixture',1)
+        self.assertEqual(len(item.provenance[0]['query_ranks']),2)
+    def test_failed_variant_retains_original_results_and_operator_filtering(self):
+        class Mixed:
+            name='mixed';general_web=True
+            def search(self,request,deadline):
+                if not request.query.startswith('Please'):raise ValueError('Injected variant failure')
+                return SourceBatch([row('https://docs.example.org/sensor','Orbital sensor calibration','Orbital sensor calibration guide.'),
+                                    row('https://other.example.org/sensor','Orbital sensor calibration','Orbital sensor calibration guide.')])
+        result=LiveSearch(settings(live_query_variants=3),[Mixed()]).search(
+            'Please find orbital sensor calibration site:docs.example.org',fetch_pages=False)
+        self.assertEqual([r['url'] for r in result['results']],['https://docs.example.org/sensor'])
+        self.assertTrue(any(s['status']=='error' for s in result['provider_status']))
+    def test_variants_share_single_physical_provider_request_budget(self):
+        from unittest.mock import patch
+        from ownsearch.fetcher import Fetcher,FetchResult
+        class BudgetSource(JsonProvider):
+            name='budget'
+            def search(self,request,deadline):
+                self.request(request,'https://api.example.org/search',deadline)
+                return SourceBatch()
+        cfg=settings(live_query_variants=3,provider_request_budget=1)
+        with patch.object(Fetcher,'fetch',return_value=FetchResult('','',200,{},b'{}')) as fetch:
+            result=LiveSearch(cfg,[BudgetSource(cfg)]).search('Please find the orbital sensor guide',fetch_pages=False)
+        self.assertEqual(fetch.call_count,1)
+        self.assertTrue(any(s['status']=='rate_limited' for s in result['provider_status']))
+    def test_original_reserves_budget_before_faster_variants(self):
+        from unittest.mock import patch
+        from ownsearch.fetcher import Fetcher,FetchResult
+        class SlowOriginal(JsonProvider):
+            name='priority'
+            def search(self,request,deadline):
+                if request.query.startswith('Please'):time.sleep(.05)
+                self.request(request,'https://api.example.org/search?q='+request.query,deadline)
+                return SourceBatch()
+        cfg=settings(live_query_variants=3,provider_request_budget=1)
+        with patch.object(Fetcher,'fetch',return_value=FetchResult('','',200,{},b'{}')) as fetch:
+            LiveSearch(cfg,[SlowOriginal(cfg)]).search('Please find the orbital sensor guide',fetch_pages=False)
+        self.assertEqual(fetch.call_count,1)
+        self.assertIn('Please find',fetch.call_args.args[0])
+    def test_recorder_delegates_routing_and_associates_variant_snapshots(self):
+        source=Source('fixture');source.accepts=lambda req:False
+        recorder=Recorder(source);req=self.request('sensor guide');req.original_query='Please find sensor guide'
+        self.assertFalse(recorder.accepts(req))
+        recorder.search(req,time.monotonic()+1)
+        self.assertEqual(len(recorder.snapshot(req.original_query)),1)
