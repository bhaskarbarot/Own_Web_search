diff --git a/ownsearch/queryvariants.py b/ownsearch/queryvariants.py
new file mode 100644
index 0000000..f5b4747
--- /dev/null
+++ b/ownsearch/queryvariants.py
@@ -0,0 +1,68 @@
+"""Bounded lexical variants and RRF, without generated facts or topic aliases."""
+import re
+from collections import defaultdict
+from .textproc import STOPWORDS
+from .webmodels import web_url
+from .webproviders import SourceBatch
+from .providers import Response
+
+
+_PREFIX=re.compile(
+    r'^(?:(?:can|could|would|will)\s+you\s+(?:please\s+)?(?:help\s+me\s+(?:to\s+)?)?'
+    r'|please\s+(?:help\s+me\s+(?:to\s+)?)?|help\s+me\s+(?:to\s+)?)'
+    r'(?:find|search\s+for|look\s+up|show\s+me|give\s+me|tell\s+me\s+about)\s+'
+    r'|^(?:i\s+(?:am\s+looking\s+for|am\s+searching\s+for|need|want\s+to\s+find)'
+    r'|find|search\s+for|show\s+me|tell\s+me\s+about)\s+',re.I)
+_TOKENS=re.compile(r'-?(?:\w+:)?"[^"\n]*"|\S+')
+
+
+def compact_request(text):
+    """Remove only an anchored request prefix; preserve every remaining qualifier."""
+    value=_PREFIX.sub('',text,count=1).strip()
+    return value if len(value.split())>=2 else text
+
+
+def variants(request,maximum=3):
+    original=request.query
+    result=[original]
+    if maximum<=1 or request.search_type!='web':return result
+    compact=compact_request(original)
+    if compact!=original:result.append(compact)
+    # Natural-language negation can depend on stopwords. Keep its complete wording.
+    if not re.search(r'\b(?:not|no|without|except|excluding|rather|versus|vs)\b',compact,re.I):
+        words=_TOKENS.findall(compact)
+        keywords=' '.join(w for w in words if w.lower() not in STOPWORDS)
+        if len(keywords.split())>=2 and keywords not in result:result.append(keywords)
+    # No synonym is invented. Optional source-supported aliases belong in future
+    # variants only after their provenance and quality are measured.
+    return result[:maximum]
+
+
+def rrf_rows(batches,limit=40):
+    scores=defaultdict(float);rows={};rankings=defaultdict(list)
+    for batch in batches:
+        seen=set()
+        for position,row in enumerate(batch.rows[:limit],1):
+            if not isinstance(row,dict) or not (url:=web_url(row.get('url'))) or url in seen:continue
+            seen.add(url);scores[url]+=1/(60+position)
+            rows.setdefault(url,dict(row))
+            rankings[url].append({'query':str(row.get('source_query',''))[:1000],'rank':position})
+    output=[]
+    for url in sorted(scores,key=lambda u:(-scores[u],u))[:limit]:
+        row=rows[url];row['source_query_ranks']=rankings[url]
+        row['source_rank_method']='reciprocal_rank_fusion'
+        output.append(row)
+    return output
+
+
+def fuse_responses(responses,limit=40):
+    groups={}
+    for response in responses:groups.setdefault(response.provider,[]).append(response)
+    output=[]
+    for provider,group in groups.items():
+        batches=[r.results for r in group if r.status=='ok' and isinstance(r.results,SourceBatch)]
+        if len(batches)<=1:
+            output.extend(group);continue
+        warnings=list(dict.fromkeys(w for b in batches for w in b.warnings))
+        output.append(Response(provider,SourceBatch(rrf_rows(batches,limit),warnings)))
+    return output
